datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Card {
  id            String    @id @default(uuid())
  bankName      String    @map("bank_name")
  brand         String
  last4Digits   String    @map("last_4_digits")
  colorGradient String?   @map("color_gradient")
  pdfPassword   String?   @map("pdf_password")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  invoices      Invoice[]
  recurringItems RecurringItem[]

  @@unique([bankName, brand, last4Digits])
  @@map("cards")
}

model Invoice {
  id              String        @id @default(uuid())
  cardId          String        @map("card_id")
  card            Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  monthYear       String        @map("month_year") // Formato "YYYY-MM" (Ex: "2026-09")
  dueDate         DateTime?     @map("due_date")
  totalAmount     Decimal       @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  purchasesAmount Decimal       @default(0.00) @map("purchases_amount") @db.Decimal(10, 2)
  fineAmount      Decimal       @default(0.00) @map("fine_amount") @db.Decimal(10, 2)
  interestAmount  Decimal       @default(0.00) @map("interest_amount") @db.Decimal(10, 2)
  taxesAmount     Decimal       @default(0.00) @map("taxes_amount") @db.Decimal(10, 2)
  feesAmount      Decimal       @default(0.00) @map("fees_amount") @db.Decimal(10, 2)
  creditsAmount   Decimal       @default(0.00) @map("credits_amount") @db.Decimal(10, 2)
  declaredAmount  Decimal?      @map("declared_amount") @db.Decimal(10, 2) // Total a pagar declarado no boleto/PDF
  isPaid          Boolean       @default(false) @map("is_paid")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  items           InvoiceItem[]
  fees            InvoiceFee[]

  @@unique([cardId, monthYear])
  @@map("invoices")
}

model InvoiceItem {
  id                 String    @id @default(uuid())
  invoiceId          String    @map("invoice_id")
  invoice            Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description        String
  originalAmount     Decimal   @map("original_amount") @db.Decimal(10, 2)
  currentInstallment Int       @default(1) @map("current_installment")
  totalInstallments  Int       @default(1) @map("total_installments")
  itemType           String    @default("PURCHASE") @map("item_type") // 'PURCHASE' | 'FEE' | 'FINE' | 'INTEREST' | 'TAX' | 'CREDIT'
  purchaseDate       DateTime?      @map("purchase_date")
  extractedBy        String         @default("ai") @map("extracted_by") // 'ai' | 'regex'
  isRecurring        Boolean        @default(false) @map("is_recurring")
  recurringItemId    String?        @map("recurring_item_id")
  recurringItem      RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([recurringItemId])
  @@map("invoice_items")
}

model RecurringItem {
  id             String       @id @default(uuid())
  cardId         String       @map("card_id")
  card           Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  description    String
  amount         Decimal      @map("amount") @db.Decimal(10, 2)
  startMonthYear String       @map("start_month_year") // "YYYY-MM" — primeira fatura onde aparece
  endMonthYear   String?      @map("end_month_year") // null = para sempre
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  items          InvoiceItem[]

  @@index([cardId])
  @@map("recurring_items")
}

model InvoiceFee {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(10, 2)
  feeType     String   @map("fee_type") // 'FINE' | 'INTEREST' | 'TAX' | 'FEE' | 'OTHER'
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_fees")
}

model BankInstruction {
  id        String   @id @default(uuid())
  bankName  String   @map("bank_name")
  keywords  String   @map("keywords") @db.Text
  rules     String   @map("rules") @db.Text
  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bankName])
  @@map("bank_instructions")
}
